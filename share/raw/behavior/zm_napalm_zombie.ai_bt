{
    "id": "zombie_napalm",
    "type": "selector",
    "children": [
        {
            "id": "zombiedeathbehavior",
            "type": "selector",
            "children": [
				{
					"id": "freezegundeath",
					"type": "sequence",
					"children": [
						{
							"id": "waskilledbyfreezegun",
							"type": "condition_script",
							"scriptFunction": "zombiewasKilledByFreezeGun",
							"interruptName": "death"
						},
						{
							"id": "freezegundeathaction",
							"type": "action",
							"ActionName": "defaultaction",
							"ASMStateName": "freezegun_death@zombie",
							"actionNotify": "death",
							"StartFunction": "zombiedeathaction"
						}
					]
				},
                {
                    "id": "defaultdeathbehavior",
                    "type": "sequence",
                    "children": [
                        {
                            "id": "waskilled",
                            "type": "condition_script",
                            "interruptName": "death"
                        },
                        {
                            "id": "deathaction",
                            "type": "action",
                            "ActionName": "defaultaction",
                            "ASMStateName": "death@zombie_napalm",
                            "actionNotify": "death",
                            "StartFunction": "zombiedeathaction",
                            "TerminateFunction": "startragdoll"
                        }
                    ]
                }
            ]
        },
        {
            "id": "proceduraltraversebehavior",
            "type": "sequence",
            "children": [
                {
                    "id": "shouldtraverse",
                    "type": "condition_script",
                    "scriptFunction": "locomotionshouldtraverse",
                    "interruptName": "traverse"
                },
                {
                    "id": "shouldproceduraltraverse",
